[gd_scene load_steps=5 format=3]

[ext_resource type="Script" path="res://scripts/ui/loading_screen_ui.gd" id="1_script"]
[ext_resource type="Theme" path="res://resources/themes/game_ui_theme.tres" id="2_theme"]

[sub_resource type="StyleBoxFlat" id="ProgressBackground"]
bg_color = Color(0.035, 0.052, 0.074, 1)
border_width_left = 2
border_width_top = 2
border_width_right = 2
border_width_bottom = 2
border_color = Color(0.28, 0.35, 0.43, 1)
corner_radius_top_left = 6
corner_radius_top_right = 6
corner_radius_bottom_right = 6
corner_radius_bottom_left = 6

[sub_resource type="StyleBoxFlat" id="ProgressFill"]
bg_color = Color(0.91, 0.75, 0.43, 1)
corner_radius_top_left = 4
corner_radius_top_right = 4
corner_radius_bottom_right = 4
corner_radius_bottom_left = 4
expand_margin_left = -4.0
expand_margin_top = -4.0
expand_margin_right = -4.0
expand_margin_bottom = -4.0

[node name="LoadingScreenUI" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
theme = ExtResource("2_theme")
script = ExtResource("1_script")
target_scene_path = "res://scenes/main/main.tscn"
minimum_display_seconds = 0.9
bar_fill_speed = 135.0
loading_status_text = "PREPARING THE DAY SERVICE"
ready_status_text = "SHIFT READY"
failed_status_text = "THE SHIFT COULD NOT BE LOADED"
progress_text_template = "%d%%"

[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
color = Color(0.018, 0.027, 0.041, 1)

[node name="UpperGlow" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 10
anchor_right = 1.0
offset_bottom = 5.0
grow_horizontal = 2
mouse_filter = 2
color = Color(0.91, 0.75, 0.43, 0.7)

[node name="Center" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2

[node name="Content" type="VBoxContainer" parent="Center"]
custom_minimum_size = Vector2(660, 0)
layout_mode = 2
theme_override_constants/separation = 18

[node name="Eyebrow" type="Label" parent="Center/Content"]
layout_mode = 2
theme_override_colors/font_color = Color(0.61, 0.55, 0.45, 1)
theme_override_font_sizes/font_size = 15
text = "NIGHT RAILWAY SERVICE"
horizontal_alignment = 1

[node name="Title" type="Label" parent="Center/Content"]
theme_type_variation = &"HeaderLabel"
layout_mode = 2
theme_override_colors/font_color = Color(0.94, 0.85, 0.65, 1)
theme_override_font_sizes/font_size = 42
text = "WHERE DO YOU BELONG?"
horizontal_alignment = 1

[node name="Rule" type="HSeparator" parent="Center/Content"]
custom_minimum_size = Vector2(0, 18)
layout_mode = 2

[node name="StatusLabel" type="Label" parent="Center/Content"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(0.84, 0.83, 0.8, 1)
theme_override_font_sizes/font_size = 17
text = "PREPARING THE DAY SERVICE"
horizontal_alignment = 1

[node name="ProgressBar" type="ProgressBar" parent="Center/Content"]
unique_name_in_owner = true
custom_minimum_size = Vector2(660, 24)
layout_mode = 2
theme_override_styles/background = SubResource("ProgressBackground")
theme_override_styles/fill = SubResource("ProgressFill")
show_percentage = false

[node name="ProgressLabel" type="Label" parent="Center/Content"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(0.91, 0.75, 0.43, 1)
theme_override_font_sizes/font_size = 16
text = "0%"
horizontal_alignment = 1

[node name="Footer" type="Label" parent="."]
layout_mode = 1
anchors_preset = 12
