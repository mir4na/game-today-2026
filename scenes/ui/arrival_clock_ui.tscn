[gd_scene load_steps=4 format=3]

[ext_resource type="Script" path="res://scripts/ui/arrival_clock_ui.gd" id="1"]
[ext_resource type="Theme" path="res://resources/themes/game_ui_theme.tres" id="2"]

[sub_resource type="StyleBoxFlat" id="ArrivalClockPanelStyle"]
content_margin_left = 26.0
content_margin_top = 22.0
content_margin_right = 26.0
content_margin_bottom = 22.0
bg_color = Color(0.0509804, 0.0627451, 0.0784314, 0.98)
