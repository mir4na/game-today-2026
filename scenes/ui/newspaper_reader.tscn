theme_override_fonts/bold_font = ExtResource("3_15k6j")
theme_override_font_sizes/normal_font_size = 25
theme_override_font_sizes/bold_font_size = 25
bbcode_enabled = true
text = "A cleaning attendant was found murdered during an overnight shift after failing to report at the end of duty. Authorities identified the victim as [b]ELENI[/b], aged 34. Investigators believe the attack occurred while the attendant was cleaning an isolated service area, where overturned equipment and a bloodstained cloth were recovered. Access remained sealed through the morning as officers questioned night staff and reviewed movement around the final scheduled trains."

