text = "PASSENGER DIES IN TRAIN FIRE"

[node name="Desc1" type="RichTextLabel" parent="Type1" unique_id=1100738312]
editor_description = "Primary Case C preview copy. Runtime replaces only the text."
layout_mode = 0
offset_left = 86.66667
offset_top = 245.0
offset_right = 492.33337
offset_bottom = 361.0
mouse_filter = 2
theme_override_colors/default_color = Color(0.3019608, 0.24705882, 0.21960784, 1)
theme_override_fonts/normal_font = ExtResource("4_koq3p")
theme_override_fonts/bold_font = ExtResource("3_15k6j")
theme_override_font_sizes/normal_font_size = 13
theme_override_font_sizes/bold_font_size = 13
bbcode_enabled = true
text = "A fire swept through a passenger carriage shortly before dawn, filling the compartment with heavy smoke before the train could stop. Authorities confirmed that [b]ELENI[/b], aged 34, was trapped inside when flames spread across the rear doorway and blocked the nearest exit. Railway staff uncoupled the damaged carriage as emergency crews contained the blaze. The train remains sealed while investigators examine the electrical system and interior fittings."

[node name="Desc2" type="RichTextLabel" parent="Type1" unique_id=908591944]
editor_description = "Secondary Case C preview copy. Runtime replaces only the text."
layout_mode = 0
offset_left = 514.99994
offset_top = 244.5238
offset_right = 913.7619
offset_bottom = 360.5238
mouse_filter = 2
theme_override_colors/default_color = Color(0.3019608, 0.24705882, 0.21960784, 1)
theme_override_fonts/normal_font = ExtResource("4_koq3p")
theme_override_fonts/bold_font = ExtResource("3_15k6j")
theme_override_font_sizes/normal_font_size = 13
theme_override_font_sizes/bold_font_size = 13
bbcode_enabled = true
text = "Records show the victim boarded at Asterfall and worked as a tailor. Investigators are reviewing witness statements, carriage maintenance logs, and the emergency response. The cause remains undetermined, and services using similar rolling stock face additional inspections.

Edition printed before the afternoon service departed."

