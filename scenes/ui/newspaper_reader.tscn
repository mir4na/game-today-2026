[node name="Desc1" type="RichTextLabel" parent="Type1" unique_id=1100738312]
editor_description = "Primary Case C preview copy. Runtime replaces only the text."
layout_mode = 0
offset_left = 86.66667
offset_top = 245.0
offset_right = 503.3333
offset_bottom = 361.0
mouse_filter = 2
theme_override_colors/default_color = Color(0.3019608, 0.24705882, 0.21960784, 1)
theme_override_fonts/normal_font = ExtResource("4_koq3p")
theme_override_fonts/bold_font = ExtResource("3_15k6j")
theme_override_font_sizes/normal_font_size = 13
theme_override_font_sizes/bold_font_size = 13
bbcode_enabled = true
text = "A workplace fire broke out shortly after sunrise. Night staff reported smoke spreading from a rear storage room before the alarm sounded. Authorities confirmed that [b]ELENI[/b], aged 34, was working inside when the blaze crossed the upper floor and blocked the main corridor. Emergency crews opened a second entry point after witnesses saw flames through the rear windows. The site remained closed while recovery work continued through the morning."

[node name="Desc2" type="RichTextLabel" parent="Type1" unique_id=908591944]
editor_description = "Secondary Case C preview copy. Runtime replaces only the text."
layout_mode = 0
offset_left = 514.99994
offset_top = 243.33334
offset_right = 919.99994
offset_bottom = 359.33334
mouse_filter = 2
theme_override_colors/default_color = Color(0.3019608, 0.24705882, 0.21960784, 1)
theme_override_fonts/normal_font = ExtResource("4_koq3p")
theme_override_fonts/bold_font = ExtResource("3_15k6j")
theme_override_font_sizes/normal_font_size = 13
theme_override_font_sizes/bold_font_size = 13
bbcode_enabled = true
text = "Investigators stated that the local tailor could not have survived the incident. Employment records and witness statements are under review while the building remains closed. The alarm sequence is being traced; no final cause has been announced.

Edition printed before the afternoon service departed."

