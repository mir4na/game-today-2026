[node name="Header" type="HBoxContainer" parent="ReaderCenter/ReaderPanel/ReaderLayout"]
layout_mode = 2

[node name="ReaderTitle" type="Label" parent="ReaderCenter/ReaderPanel/ReaderLayout/Header"]
