custom_minimum_size = Vector2(1040, 600)
layout_mode = 2
theme_override_styles/panel = SubResource("ReaderPanelStyle")

[node name="ReaderLayout" type="VBoxContainer" parent="ReaderCenter/ReaderPanel"]
