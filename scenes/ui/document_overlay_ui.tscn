[node name="DocumentOverlayUI" type="Control"]
visible = false
process_mode = 3
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 0
theme = ExtResource("2")
script = ExtResource("1")
non_death_headline = "RAIL BRIDGE REOPENS"
non_death_primary_template = "[b]%s[/b], the restoration supervisor, confirmed that the coastal bridge reopened after months of structural repairs. Crews replaced damaged supports, reinforced the eastern span, and completed final safety checks before the first scheduled departure. A supervised test train crossed at reduced speed before regular traffic was cleared. The renewed line passed braking and signal tests without delay. No injuries were reported during the work."
non_death_secondary_headline = "SERVICE OUTLOOK"
non_death_secondary_template = "Passenger and freight schedules are expected to normalize this week. Speed restrictions will remain while inspectors monitor the span in active service. A second engineering review is planned after the first full week of traffic.\n\nEdition printed before the afternoon service left %s."
external_death_headline = "HARBORMASTER FOUND DEAD"
external_death_primary_template = "The retired harbormaster [b]%s[/b], aged 71, was discovered at a coastal residence shortly after sunrise after a neighbor requested a wellness check. Officials sealed the residence while investigators documented the rooms and collected personal records from the victim's study. Detectives photographed the study and garden entrance before the body was removed under guard. A locked ledger and several unopened letters were taken as evidence."
external_death_secondary_headline = "CASE STATUS"
external_death_secondary_template = "Authorities reported no sign of forced entry. Former coworkers and nearby residents are being interviewed as investigators reconstruct the victim's final hours. The coroner is comparing household records with witness accounts; no official cause has yet been released.\n\nEdition printed before the afternoon service left %s."
matching_death_headline = "MORNING FIRE CLAIMS LIFE"
matching_death_primary_template = "A workplace fire broke out shortly after sunrise. Night staff reported smoke spreading from a rear storage room before the alarm sounded. Authorities confirmed that [b]%s[/b], aged %d, was working inside when the blaze crossed the upper floor and blocked the main corridor. Emergency crews opened a second entry point after witnesses saw flames through the rear windows. The site remained closed while recovery work continued through the morning."
matching_death_secondary_headline = "INVESTIGATION"
matching_death_secondary_template = "Investigators stated that the %s %s could not have survived the incident. Employment records and witness statements are under review while the building remains closed. The alarm sequence is being traced; no final cause has been announced.\n\nEdition printed before the afternoon service left %s."
departure_statement_title = "DEPARTURE STATEMENT"
departure_statement_template = "[font_size=28][b]%s[/b][/font_size]\n\n[color=#c9ad79]STATEMENT[/color]\n\n\"%s\"\n\n[font_size=15][color=#9c9386]%s[/color][/font_size]"
departure_statement_recorded_text = "Statement recorded in the night ledger."
departure_statement_reread_text = "Statement already recorded."
missing_departure_statement_text = "[color=#c98f87]This passenger has no configured departure statement.[/color]"

