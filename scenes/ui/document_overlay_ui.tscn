[ext_resource type="Theme" path="res://resources/themes/game_ui_theme.tres" id="2"]
[ext_resource type="PackedScene" path="res://scenes/ui/passenger_documents.tscn" id="3"]

[sub_resource type="StyleBoxFlat" id="ReaderPanelStyle"]
content_margin_left = 24.0
content_margin_top = 20.0
content_margin_right = 24.0
content_margin_bottom = 20.0
bg_color = Color(0.0980392, 0.137255, 0.180392, 1)
border_width_left = 2
border_width_top = 2
border_width_right = 2
border_width_bottom = 2
border_color = Color(0.819608, 0.678431, 0.439216, 1)
corner_radius_top_left = 9
corner_radius_top_right = 9
corner_radius_bottom_right = 9
corner_radius_bottom_left = 9

[node name="DocumentOverlayUI" type="Control"]
visible = false
process_mode = 3
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 0
theme = ExtResource("2")
script = ExtResource("1")
newspaper_title = "THE AFTERNOON DISPATCH"
non_death_subject_names = PackedStringArray("Mara", "Silas", "Nadia", "Rufus", "Elara", "Tomas")
non_death_newspaper_template = "[font_size=28][b]RESTORED RAIL BRIDGE REOPENS[/b][/font_size]\n\n%s, the project supervisor, announced that the coastal rail bridge has reopened after months of repairs.\n\nOfficials expect regular freight service to resume before the end of the week. The reopening was completed without disruption to scheduled service.\n\n[font_size=15][color=#9c9386]Edition printed before the afternoon service left %s.[/color][/font_size]"
external_death_subject_names = PackedStringArray("Mara", "Silas", "Nadia", "Rufus", "Elara", "Tomas")
external_death_newspaper_template = "[font_size=28][b]RETIRED HARBORMASTER DIES AT COASTAL HOME[/b][/font_size]\n\n%s, 71, was found dead at a coastal home early this morning. No passenger aboard this service carries that name.\n\nAuthorities described the death as natural and closed the investigation.\n\n[font_size=15][color=#9c9386]Edition printed before the afternoon service left %s.[/color][/font_size]"
matching_death_newspaper_template = "[font_size=28][b]LOCAL %s DIES IN MORNING FIRE[/b][/font_size]\n\n%s, %d, was confirmed dead after a fire swept through their workplace shortly after sunrise.\n\nAuthorities stated that the %s %s could not have survived the blaze.\n\n[font_size=15][color=#9c9386]Edition printed before the afternoon service left %s.[/color][/font_size]"
departure_statement_title = "DEPARTURE STATEMENT"
departure_statement_template = "[font_size=28][b]%s[/b][/font_size]\n\n[color=#c9ad79]STATEMENT[/color]\n\n\"%s\"\n\n[font_size=15][color=#9c9386]%s[/color][/font_size]"
departure_statement_recorded_text = "Statement recorded in the night ledger."
departure_statement_reread_text = "Statement already recorded."
missing_departure_statement_text = "[color=#c98f87]This passenger has no configured departure statement.[/color]"

