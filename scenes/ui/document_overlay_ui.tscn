[node name="ReaderCenter" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2

[node name="ReaderPanel" type="PanelContainer" parent="ReaderCenter"]
unique_name_in_owner = true
