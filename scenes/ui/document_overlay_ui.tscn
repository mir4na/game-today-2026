[node name="CloseButton" type="Button" parent="ReaderCenter/ReaderPanel/ReaderLayout/Header"]
layout_mode = 2
text = "CLOSE  [ESC]"

[node name="ReaderContent" type="RichTextLabel" parent="ReaderCenter/ReaderPanel/ReaderLayout"]
