[node name="DocumentOverlayUI" type="Control"]
visible = false
process_mode = 3
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 0
theme = ExtResource("2")
script = ExtResource("1")
non_death_headline = "DRY SEASON SETTLES IN"
non_death_primary_template = "Regional forecaster [b]%s[/b] confirmed that the dry season has arrived after rainfall fell sharply across the eastern district. Clear skies and rising afternoon temperatures are expected throughout the coming weeks. Farmers have begun adjusting irrigation schedules, while residents are being asked to conserve water and avoid burning waste near grassland. Weather officials will continue monitoring wells, reservoirs, and fire-prone areas each morning."
non_death_secondary_headline = "PUBLIC ADVISORY"
non_death_secondary_template = "Rail passengers should carry drinking water and prepare for hotter platforms during midday service. Municipal crews are inspecting pumps and distributing supplies to neighborhoods with limited reserves. Further updates will be issued if temperatures continue to rise.\n\nEdition printed before the afternoon service left %s."
non_death_alt_headline = "YEAR-END HOLIDAYS BEGIN"
non_death_alt_primary_template = "Year-end holidays have officially begun, bringing a sharp rise in visitors across the region. Tourism coordinator [b]%s[/b] said hotels, markets, and public attractions are preparing extended hours for families arriving throughout the week. Travelers are advised to reserve accommodation early, keep tickets ready, and expect crowded roads near major destinations. Extra information desks will operate daily as local businesses prepare seasonal events, food stalls, and evening performances for holiday guests."
non_death_alt_secondary_headline = "VISITOR NOTICE"
non_death_alt_secondary_template = "Additional rail services and shuttle buses will serve popular districts during peak hours. Visitors should watch station announcements, safeguard personal belongings, and allow extra time between connections. Local authorities have also opened temporary rest areas and first-aid posts.\n\nEdition printed before the afternoon service left %s."
matching_death_headline = "PASSENGER DIES IN TRAIN FIRE"
matching_death_primary_template = "A fire swept through a passenger carriage shortly before dawn, filling the compartment with heavy smoke before the train could stop. Authorities confirmed that [b]%s[/b], aged %d, was trapped inside when flames spread across the rear doorway and blocked the nearest exit. Railway staff uncoupled the damaged carriage as emergency crews contained the blaze. The train remains sealed while investigators examine the electrical system and interior fittings."
matching_death_secondary_headline = "RAIL SAFETY INQUIRY"
matching_death_secondary_template = "Records show the victim boarded at %s and worked as a %s. Investigators are reviewing witness statements, carriage maintenance logs, and the emergency response. The cause remains undetermined, and services using similar rolling stock face additional inspections.\n\nEdition printed before the afternoon service left %s."
matching_death_alt_headline = "CLEANING ATTENDANT FOUND MURDERED"
matching_death_alt_primary_template = "A cleaning attendant was found murdered during an overnight shift after failing to report at the end of duty. Authorities identified the victim as [b]%s[/b], aged %d. Investigators believe the attack occurred while the attendant was cleaning an isolated service area, where overturned equipment and a bloodstained cloth were recovered. Access remained sealed through the morning as officers questioned night staff and reviewed movement around the final scheduled trains."
matching_death_alt_secondary_headline = "NIGHT-SHIFT KILLING"
matching_death_alt_secondary_template = "Records show the victim traveled from %s and was employed as a %s before taking the overnight cleaning assignment. Detectives are examining cleaning equipment, staff logs, and witness accounts. No suspect has been named, and the motive remains unknown.\n\nEdition printed before the afternoon service left %s."
departure_statement_title = "DEPARTURE STATEMENT"
departure_statement_template = "[font_size=28][b]%s[/b][/font_size]\n\n[color=#c9ad79]STATEMENT[/color]\n\n\"%s\"\n\n[font_size=15][color=#9c9386]%s[/color][/font_size]"
departure_statement_recorded_text = "Statement recorded in the night ledger."
departure_statement_reread_text = "Statement already recorded."
missing_departure_statement_text = "[color=#c98f87]This passenger has no configured departure statement.[/color]"

