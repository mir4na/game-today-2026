[gd_scene load_steps=4 format=3]

[ext_resource type="Script" path="res://scripts/ui/pause_ui.gd" id="1"]
[ext_resource type="Theme" path="res://resources/themes/game_ui_theme.tres" id="2"]

[sub_resource type="StyleBoxFlat" id="PausePanelStyle"]
content_margin_left = 18.0
content_margin_top = 14.0
content_margin_right = 18.0
content_margin_bottom = 14.0
bg_color = Color(0.0901961, 0.129412, 0.176471, 1)
border_width_left = 2
border_width_top = 2
border_width_right = 2
border_width_bottom = 2
border_color = Color(0.772549, 0.639216, 0.423529, 1)
corner_radius_top_left = 8
corner_radius_top_right = 8
corner_radius_bottom_right = 8
corner_radius_bottom_left = 8

[node name="PauseUI" type="Control"]
visible = false
process_mode = 3
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 0
theme = ExtResource("2")
script = ExtResource("1")

[node name="Shade" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.01, 0.015, 0.025, 0.82)

[node name="Center" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Panel" type="PanelContainer" parent="Center"]
custom_minimum_size = Vector2(430, 435)
layout_mode = 2
theme_override_styles/panel = SubResource("PausePanelStyle")

[node name="Box" type="VBoxContainer" parent="Center/Panel"]
layout_mode = 2
theme_override_constants/separation = 16
alignment = 1

[node name="Title" type="Label" parent="Center/Panel/Box"]
layout_mode = 2
theme_override_colors/font_color = Color(0.933333, 0.827451, 0.607843, 1)
theme_override_font_sizes/font_size = 29
text = "SHIFT PAUSED"
horizontal_alignment = 1

[node name="Controls" type="Label" parent="Center/Panel/Box"]
layout_mode = 2
theme_override_colors/font_color = Color(0.905882, 0.878431, 0.823529, 1)
theme_override_font_sizes/font_size = 16
text = "A / D or Arrows — Walk\nE — Interact\nTAB — Notebook\nESC — Pause / Close"
horizontal_alignment = 1

[node name="ResumeButton" type="Button" parent="Center/Panel/Box"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 48)
layout_mode = 2
text = "RESUME"

[node name="RestartButton" type="Button" parent="Center/Panel/Box"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 48)
layout_mode = 2
text = "RESTART SHIFT"

[node name="MainMenuButton" type="Button" parent="Center/Panel/Box"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 48)
layout_mode = 2
text = "MAIN MENU"

[connection signal="pressed" from="Center/Panel/Box/ResumeButton" to="." method="_on_resume_button_pressed"]
[connection signal="pressed" from="Center/Panel/Box/RestartButton" to="." method="_on_restart_button_pressed"]
[connection signal="pressed" from="Center/Panel/Box/MainMenuButton" to="." method="_on_main_menu_button_pressed"]
