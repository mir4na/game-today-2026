[node name="GuidebookUI" type="Control" unique_id=29174819]
process_mode = 3
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("2_theme")
script = ExtResource("1_script")
today_document_template = "[table=2][cell][font_size=18][b]SERVICE DETAILS[/b][/font_size]
[b]Day[/b]  %d
[b]Date[/b]  %s
[b]Train number[/b]  %s

[font_size=18][b]SHIFT TARGET[/b][/font_size]
[b]Required[/b]  %d Blessings
[b]Earned today[/b]  %d Blessings
[b]Still needed[/b]  %d Blessings

[color=#6b5a4f]Only this shift's earnings count toward today's target.[/color][/cell][cell][font_size=18][b]PASSENGERS[/b][/font_size]
[b]Boarded today[/b]  %d
[b]Currently aboard[/b]  %d
[b]Stamped aboard[/b]  %d

[font_size=18][b]ROUTE PROGRESS[/b][/font_size]
[b]Stops completed[/b]  %d / %d
[b]Day code[/b]  %s
[b]Current station[/b]  %s
[b]Next station[/b]  %s

%s[/cell][/table]"
completed_service_text = "DAY SERVICE COMPLETE"
procedure_document = "[table=2][cell][font_size=18][b]INSPECT & DECIDE[/b][/font_size]
Compare each passenger's ID, ticket, and appearance with today's service and the Anomaly List.

[font_size=18][b]DAYTIME DROP-OFFS[/b][/font_size]
Stamp an ordinary passenger only when their required stop is next.

[font_size=18][b]KEEP ANOMALIES ABOARD[/b][/font_size]
Do not stamp anomalies; they remain aboard for night service.

[font_size=18][b]PASS THE SHIFT[/b][/font_size]
Meet today's paycheck target or restart the failed shift.

[font_size=18][b]NIGHT SERVICE[/b][/font_size]
Use Departure Statements to assign every remaining soul to a symbolic destination.

[font_size=18][b]BLESSINGS & PENALTIES[/b][/font_size]
[b]+30 Blessings[/b] — Correct passenger drop-off.
[b]−20 Blessings[/b] — Incorrect passenger drop-off.
[b]−40 Blessings[/b] — Anomaly wrongly stamped, once per shift.
Keeping an anomaly aboard has no penalty.[/cell][cell][font_size=18][b]SHIFT FLOW[/b][/font_size]
Inspect every passenger before deciding.

Keep anomalies aboard for night service.

Ask the watcher to finish the route early when the work is done.

Find Departure Statements at night and assign every soul correctly.[/cell][/table]"

