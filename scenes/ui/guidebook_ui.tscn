[node name="GuidebookUI" type="Control"]
visible = false
process_mode = 3
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 0
theme = ExtResource("2")
script = ExtResource("1")
day_badge_template = "DAY %d"
train_badge_template = "TRAIN  %s"
date_badge_template = "%s"
today_document_template = "[font_size=22][b]DAY %d • %s[/b][/font_size]\n[b]Train number[/b]  %s\n\n[font_size=20][b]PASS TARGET: %d BLESSINGS[/b][/font_size]\n[b]Net earnings so far[/b]  %d Blessings\n[b]Still needed[/b]  %d Blessings\n[color=#6b4a35]Today's earnings after penalties; earlier savings do not count.[/color]\n\n[font_size=20][b]PASSENGERS[/b][/font_size]\n[b]Boarded today[/b]  %d\n[b]Passengers aboard[/b]  %d\n[b]Stamped aboard[/b]  %d\n[color=#6b4a35]Boarded today includes everyone who has joined this shift, even after they leave. Stamped passengers are assigned to the next stop.[/color]\n\n[font_size=20][b]ROUTE REFERENCE[/b][/font_size]\n[b]Scheduled stops completed[/b]  %d / %d\n[b]Day code[/b]  %s\n[b]Current station[/b]  %s\n[b]Next station[/b]  %s\n\n%s"
completed_service_text = "DAY SERVICE COMPLETE"
procedure_document = "[font_size=20][b]INSPECT & DECIDE[/b][/font_size]\nCompare each passenger's ID and ticket with today's service details. Observe the passenger for signs listed in the Anomaly List before deciding who should leave.\n\n[font_size=20][b]DAYTIME DROP-OFFS[/b][/font_size]\nA stamped ticket assigns its passenger to the next daylight station. Stamp ordinary passengers when their required stop is next. A passenger on the wrong train must leave at the next station. At the terminal, all remaining living passengers leave automatically.\n\n[font_size=20][b]KEEP ANOMALIES ABOARD[/b][/font_size]\nAnomalies belong to night service. Do not stamp their tickets. A mistaken anomaly stamp incurs a penalty, and the anomaly remains aboard.\n\n[font_size=20][b]BLESSINGS & PENALTIES[/b][/font_size]\n[b]+30 Blessings[/b] — Each correct passenger drop-off.\n[b]−20 Blessings[/b] — Each incorrect passenger drop-off.\n[b]−40 Blessings[/b] — Each anomaly wrongly stamped, counted once per anomaly per shift.\nKeeping an anomaly aboard does not incur a penalty.\n\n[font_size=20][b]PASS THE SHIFT[/b][/font_size]\nYour paycheck compares this shift's earnings after penalties with the day's target. Meet or exceed the target to pass; savings from earlier shifts do not count toward it. You can restart the shift to try again.\n\n[font_size=20][b]NIGHT SERVICE[/b][/font_size]\nCollect the remaining souls' Departure Statements. Use their clues to assign each soul to a night station in the Night Drop-Off Ledger. Every required slot must contain exactly one soul before confirmation."

